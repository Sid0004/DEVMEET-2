PORT=8000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=devmeet
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Auth Secrets (can use any random string for local development)
ACCESS_TOKEN_SECRET=your_access_token_secret_here_random_hash
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_random_hash
REFRESH_TOKEN_EXPIRY=10d

# OAuth Providers (Optional for standard password login)
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mailtrap / SMTP for OTP delivery
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

ENABLE_CODE_EXECUTION=true
